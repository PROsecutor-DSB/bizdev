# Copy to .env and fill in. Nothing here is read from a committed file -
# the code reads os.environ only, so export these or use `set -a; . ./.env; set +a`.

# ---------------------------------------------------------------- the channel
TG_CHANNEL=zamesin
# Politeness delay between page requests, in seconds. Raise it, never lower it
# below ~0.5 - we slow ourselves down rather than work around rate limits.
TG_DELAY_SECONDS=1.0
TG_TIMEOUT_SECONDS=30
TG_MAX_RETRIES=4

# ------------------------------------------------- optional: official Telegram API
# Only needed for src/scraper/telethon_scraper.py, when the public web preview
# does not expose the full history. Get these at https://my.telegram.org.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_NAME=tsi_session

# --------------------------------------------------------------------- the LLM
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Together     https://api.together.xyz/v1
#   Groq         https://api.groq.com/openai/v1
#   local vLLM   http://localhost:8000/v1
#   Ollama       http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# The API key is read from the variable NAMED here, never from this file's value.
# Default variable name is LLM_API_KEY.
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=180
# Set to 0 to disable the on-disk response cache (data/processed/.llm_cache/).
LLM_CACHE=1
